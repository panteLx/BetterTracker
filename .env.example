DATABASE_URL=file:./data/sqlite.db
NODE_ENV=production
# Required in production: at least 32 random characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The URL the app is reachable at. BETTER_AUTH_ALLOWED_HOSTS and
# BETTER_AUTH_TRUSTED_ORIGINS both default to this, so you only need to set
# them yourself if the app is *also* reachable through a second hostname/IP.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_ALLOWED_HOSTS=
BETTER_AUTH_TRUSTED_ORIGINS=
# CIDR ranges of the reverse proxy in front of the app, e.g. 172.16.0.0/12.
# Leave empty when the app is exposed directly: X-Forwarded-For is then
# client-supplied and is ignored for rate limiting and audit-log IPs rather
# than trusted. Set it to get per-client login rate limits and real IPs in the
# audit log.
TRUSTED_PROXY_CIDRS=
OIDC_DISPLAY_NAME=OpenID Connect
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,profile,email
DEFAULT_LOCALE=en-US
TZ=Europe/Berlin
